class Hewan:
    def __init__(self, nama, warna="tidak diketahui"):
        self.nama = nama
        self.warna = warna

    def bersuara(self):
        print(f"{self.nama} bersuara.")

    def info_tambahan(self):
        print(f"{self.nama} adalah hewan berwarna {self.warna}.")


class Kambing(Hewan):
    def __init__(self, nama, warna="Putih"):
        super().__init__(nama, warna)

    def bersuara(self):
        print(f"{self.nama} berkata: 'Mbeek! Mbeek!'")

    def info_tambahan(self):
        print(f"{self.nama} adalah kambing berwarna {self.warna}.")

    def interaksi_dengan_hewan(self, hewan_objek):
        print(f"Berinteraksi dengan {hewan_objek.nama} :")
        hewan_objek.bersuara()

        if hasattr(hewan_objek, "info_tambahan"):
            hewan_objek.info_tambahan()

        print("_" * 20)


if __name__ == "__main__":
    kiki = Kambing("Kiki", "Putih")
    kiki.bersuara()
    kiki.info_tambahan()
