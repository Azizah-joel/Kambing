class Hewan:
  def __init__(self, nama):
    self.nama = nama

  def bersuara(self):
      print(f"{self.nama} mengeluarkan suara umum hewan.")

class Kambing(Hewan):
  def __init__(self, nama, warna):
     super().__init__(nama)
     self.warna = warna

  def bersuara(self):
     print(f"{self.nama} bilang: Mbekk! Mbeek!")

  def info_tambahan(self):
     print(f"{self.nama} adalah kambing berwarna {self.warna}.")

  @staticmethod
  def interaksi_dengan_hewan(hewan_objek) :
     print(f"Berinteraksi dengan {hewan_objek.nama} :")
     hewan_objek.bersuara()

     if hasattr(hewan_objek, 'info_tambahan') :
        hewan_objek.info_tambahan()
  
     print("_" *20)

Moly = Kambing("Moly", "Putih")
Kambing.interaksi_dengan_hewan(Moly)
